// Type-checks the tests together with the product source. Editors pick it as the nearest
// tsconfig.json for files under tests/; `npm run typecheck` runs it after the product check.
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".."
  },
  "include": ["../src/**/*.ts", "**/*.ts"],
  "exclude": []
}
